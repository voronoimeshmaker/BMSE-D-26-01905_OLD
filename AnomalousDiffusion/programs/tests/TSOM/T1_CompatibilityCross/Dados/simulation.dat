tf = 0.1
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128  
output_dir = T1/BC3
verbose = false
debug = false

# TSOM model parameters
alpha = 0.75
rho = 0.25
theta = 0.0
lambda_c = 1.0
lambda_r = 0.3333333333

# TSOM V boundary condition.
# Available values:
#   zero_value        -> V = 0
#   constant_gradient -> dV/dx = cte
#   scaled_psi        -> V = (1 - sc) * Psi
v_boundary = scaled_psi
sc = 0.15289

mms_lambda = 1.0
psi_amplitude = 2.0
# sc is the manufactured partition U/Psi for constant_gradient and scaled_psi.
# For zero_value the compatible manufactured solution uses U/Psi = 1 and V = 0.
