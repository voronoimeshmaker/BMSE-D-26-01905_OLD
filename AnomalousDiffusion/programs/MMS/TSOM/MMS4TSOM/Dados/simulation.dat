tf = 0.1
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128, 256, 512, 1024, 2048
output_dir = Saida
verbose = false
debug = false

# TSOM parameter set. P1: alpha=0.5 rho=0.5 lambda_r=1.
# P2: alpha=0.75 rho=0.25 lambda_r=1/3.
alpha = 0.75
rho = 0.25
theta = 0.0
lambda_c = 1.0
lambda_r = 0.3333333333

# MMS-4 compares the three theta values in one execution.
theta_list = 0.0, 0.5, 1.0

# For the free-energy experiment, this boundary mode represents
# V = (1 - sc) * Psi. The default sc should be f* = rho/(alpha+rho).
v_boundary = scaled_psi
sc = 0.25
