tf = 0.1
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128, 256, 512, 1024 , 2048
output_dir = MMS1-P2-A 
verbose = false
debug = false

# TSOM model parameters
alpha = 0.75
rho = 0.25
theta = 0.0
lambda_c = 1.0
lambda_r = 0.3333333333

# TSOM V boundary condition.
# Available values:
#   zero_value    -> V = 0
#   constant_gradient -> dV/dx = cte
#   scaled_psi        -> V = (1 - sc) * Psi
v_boundary = zero_value
#sc = 0.0
