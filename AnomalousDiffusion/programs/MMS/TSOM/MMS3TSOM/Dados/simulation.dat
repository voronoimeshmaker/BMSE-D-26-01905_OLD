tf = 0.1
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128, 256, 512, 1024, 2048
output_dir = Saida
verbose = false
debug = false

# TSOM parameter set. P1: alpha=0.5 rho=0.5 lambda_r=1.
# P2: alpha=0.75 rho=0.25 lambda_r=1/3.
alpha = 0.75
rho = 0.25
theta = 0.0
lambda_c = 1.0
lambda_r = 0.3333333333

# MMS-2 has g(0)=g(1)=g'(0)=g'(1)=0, so zero_value is compatible
# with the manufactured V field at the boundary.
v_boundary = zero_value
