tf = 1.0
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128, 256, 512
output_dir = SaidaPsiV
verbose = false
debug = false

# TSOMPsiV MMS2 parameter set for the (Psi,V) formulation.
alpha = 0.75
rho = 0.25
theta = 1.0
lambda_c = 1.0
lambda_r = 0.3333333333

# MMS2TSOMPsiV fixes A=1, lambda=1, f=0.5 in the driver.
# Psi uses homogeneous Neumann boundaries and V uses BC2.
v_boundary = constant_gradient
sc = 0.5
