tf = 1.0
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128, 256, 512
output_dir = SaidaPsiV
verbose = false
debug = false

# TSOMPsiV model parameters
alpha = 0.75
rho = 0.25
theta = 0.0
lambda_c = 1.0
lambda_r = 0.3333333333

# MMS1TSOMPsiV runs the full 3x3 sweep internally:
#   zero_value, constant_gradient, scaled_psi
#   theta = 0, 0.5, 1
# Manufactured parameters are fixed in the driver:
#   lambda = 1, A = 1, f = 0.5, sc = 1 - f = 0.5
