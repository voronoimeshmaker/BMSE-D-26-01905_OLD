tf = 1.0
cdt = 1.024e-1
nx_list = 8, 16, 32, 64, 128, 256, 512
output_dir = SaidaPsiV
verbose = false
debug = false

# TSOMPsiV MMS3 mass-conservation test.
alpha = 0.75
rho = 0.25
theta = 1.0
lambda_c = 1.0
lambda_r = 0.3333333333

# Psi uses homogeneous Neumann boundaries and V uses BC2.
# Initial condition: Psi=sin^2(pi*x), V=(1-f*)Psi, f*=rho/(alpha+rho)=0.25.
v_boundary = constant_gradient
